### ============================================================
### Cópia de segurança: copie para .env e ajuste os valores
### NÃO versione o arquivo .env (ele contém senhas)
### ============================================================

### Aplicação
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
NOME_SISTEMA="Confeitaria ERP"
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# URL usada nos links de recuperação de senha e confirmação de e-mail
APP_URL=http://127.0.0.1:3000

### Autenticação (tb_usuarios)
AUTH_ENABLED=true
AUTH_COOKIE=erp_sid
# Duração da sessão em horas
SESSAO_HORAS=8
# Encerra a sessão após este tempo sem nenhuma requisição
SESSAO_MINUTOS_INATIVIDADE=30
# Bloqueio temporário após N tentativas de login incorretas
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
# Validade do link de recuperação de senha
RECUPERACAO_MINUTOS=30
# Política de senha
SENHA_MIN_CARACTERES=8
# Argon2id (memória em KiB, iterações, paralelismo)
ARGON2_MEMORY_COST_KB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Tamanho máximo da foto de perfil
FOTO_MAX_BYTES=2097152
# Administrador criado automaticamente na primeira execução
# (o script npm run criar-admin cria ou promove outros administradores)
ADMIN_USUARIO=administrador
ADMIN_SENHA=admin@1234
ADMIN_NOME=Administrador
ADMIN_EMAIL=
# Exigir troca da senha do administrador no primeiro acesso
FORCAR_TROCA_SENHA_ADMIN=false

### Banco de dados (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_confeitaria_v2
DB_CONNECTION_LIMIT=10

### WhatsApp
UPLOAD_DIR=./upload
WHATSAPP_ENABLED=false
WHATSAPP_CHROME=/usr/bin/google-chrome
WHATSAPP_DATA_DIR=./.wwebjs_auth
WA_DELAY_MIN=7000
WA_DELAY_MAX=15000
WA_BATCH=10
WA_PAUSE_MIN=60000
WA_PAUSE_MAX=120000
WA_DIARIO_MAX=300

### E-mail (recuperação de senha e confirmação de endereço)
# Gmail: use uma "senha de app" em https://myaccount.google.com/apppasswords
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Confeitaria ERP <codeonsoftwares@gmail.com>"
